  "devDependencies": {"@astrojs/check":"^0.9.4","@types/react":"^19.0.0","@types/react-dom":"^19.0.0","@types/node":"^24.0.0","@types/pg":"^8.15.0","typescript":"^5.9.0","tsx":"^4.20.0","@playwright/test":"^1.56.0"}
